generator client {
  provider = "prisma-client"
  output   = "./generated/client"
  runtime  = "cloudflare"
}

datasource db {
  provider = "sqlite"
}

model Note {
  id        Int      @id @default(autoincrement())
  title     String
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
